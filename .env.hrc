# Sample .env for the HRC stack (GRCh37/hg19, api-v2.annoq.org).
# To switch: cp .env.hrc .env, then set GA_API_SECRET.
# data/anno_tree.json must also be the HRC tree (chr version "HRC.r1-1"); it is
# not switched by this file.
ES_HOST = "localhost"
ES_PORT = 9200
ES_INDEX = "annoq-annotations-v5"
ES_SCHEME = "http"
ES_URL = "http://localhost:9200/"
DATA_RSID_COL = "rs_dbSNP151"
GA_API_SECRET = "blablabla"
GA_MEASUREMENT_ID = "G-ZRDY68GK00"
DEBUG = True
SITE_HOST = "localhost"
SITE_PORT = 8000
SITE_URL = "http://localhost:8000/"
SITE_DOWNLOAD_DIR = "./downloads"
SIZE_DOWNLOAD_SIZE = 30
# Genome build of ES_INDEX and dbSNP build of its rsIDs (field rs_dbSNP151),
# returned by /version.
ANNOQ_GENOME_BUILD = "GRCh37/hg19"
ANNOQ_DBSNP_RELEASE = "151"
# WGSA version the served index was annotated with (annoq-api-v2 issue #80).
# 0.8 is PROBABLE, not confirmed. Evidence:
#   - annoq-data-builder/wgsa_08/ contains run_work.HRC.sh (the HRC run used WGSA 0.8 tooling);
#   - the HRC rsID field is rs_dbSNP151, and WGSA shipped dbSNP b151 only in 0.76 and 0.8
#     (0.76 updated to b151 on 2018-12-12; 0.8 kept it; 0.9 moved to b154),
#     per the WGSA changelog: https://sites.google.com/site/jpopgen/wgsa
ANNOQ_WGSA_VERSION = "0.8"
