# Sample .env for the TOPMed stack (GRCh38/hg38, api-v2.topmed.annoq.org).
# To switch: cp .env.topmed .env, then set GA_API_SECRET.
# data/anno_tree.json must also be the TOPMed tree (chr version "TOPMed: Freeze 8");
# it is not switched by this file.
ES_HOST = "localhost"
ES_PORT = 9200
ES_INDEX = "annoq-annotations-tm-20260828"
ES_SCHEME = "http"
ES_URL = "http://localhost:9200/"
# Elasticsearch field holding the dbSNP rsID.
# This value is used in TWO ways that are NOT interchangeable:
#   1. QUERY field  - src/graphql/resolvers/helper_resolver.py appends ".keyword" for rsID
#      lookups. rs_dbSNP is a `text` field, so an un-analyzed term query against the bare
#      field is case-sensitive and silently returns 0 hits for input like "RS123".
#   2. _source PROJECTION - src/routers/snp_router_helpers.py DEFAULT_SEARCH_PARAM.
#      Do NOT append ".keyword" there: sub-fields are absent from _source, so the field
#      would silently disappear from responses.
# If you change this field name, check both call sites.
DATA_RSID_COL = "rs_dbSNP"
GA_API_SECRET = "blablabla"
GA_MEASUREMENT_ID = "G-ZRDY68GK00"
DEBUG = True
SITE_HOST = "localhost"
SITE_PORT = 8001
SITE_URL = "http://localhost:8001/"
SITE_DOWNLOAD_DIR = "./downloads"
SIZE_DOWNLOAD_SIZE = 30
# Genome build of ES_INDEX and dbSNP build of its rsIDs, returned by /version.
# dbSNP b155: the release WGSA 0.95 ships (changelog, 2022-05-20).
ANNOQ_GENOME_BUILD = "GRCh38/hg38"
ANNOQ_DBSNP_RELEASE = "155"
# WGSA version the served index was annotated with (annoq-api-v2 issue #80).
# 0.95: the TOPMed data was built with annoq-data-builder's wgsa_095_pipeline.
ANNOQ_WGSA_VERSION = "0.95"
